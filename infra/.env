# Perfil dev (por defecto): docker compose up -d
# 1 bróker de Kafka, MongoDB con 1 miembro, 1 worker de Spark. Para el perfil completo: --env-file completo.env
# Al cambiar de perfil hay que borrar los volúmenes primero: docker compose down -v

# Kafka KRaft (bróker y controlador en el mismo nodo)
KAFKA_CLUSTER_ID=ehtjOWnBQYW5IgUBX4xH9Q
KAFKA_VOTANTES=1@kafka-1:9093
KAFKA_RF=1
KAFKA_MIN_ISR=1
# Brókers para los clientes (productor, Spark)
KAFKA_BOOTSTRAP=kafka-1:9092

# MongoDB: miembros del replica set rs0 y caché de WiredTiger por miembro
MONGO_MIEMBROS=mongo-1:27017
MONGO_CACHE_GB=1
MONGO_LIMITE=1536m

# Spark: núcleos y memoria que cada worker ofrece a los ejecutores, y límite del contenedor
SPARK_WORKER_CORES=5
SPARK_WORKER_MEMORY=3g
SPARK_WORKER_LIMITE=5g

# Núcleos de los ejecutores de cada job (spark.cores.max); suman los del worker
JOB1_NUCLEOS=1
JOB2_NUCLEOS=2
JOB2V_NUCLEOS=1
JOB3_NUCLEOS=1
