# Perfil completo: docker compose --env-file completo.env up -d
# 3 brókers de Kafka, replica set de 3 y 2 workers de Spark (pruebas de falla RNF-01, RNF-03, RNF-04 y RNF-05).
# Al cambiar de perfil hay que borrar los volúmenes primero: docker compose down -v
COMPOSE_PROFILES=completo

KAFKA_CLUSTER_ID=ehtjOWnBQYW5IgUBX4xH9Q
KAFKA_VOTANTES=1@kafka-1:9093,2@kafka-2:9093,3@kafka-3:9093
KAFKA_RF=3
KAFKA_MIN_ISR=2
KAFKA_BOOTSTRAP=kafka-1:9092,kafka-2:9092,kafka-3:9092

MONGO_MIEMBROS=mongo-1:27017,mongo-2:27017,mongo-3:27017
MONGO_CACHE_GB=0.4
MONGO_LIMITE=896m

SPARK_WORKER_CORES=3
SPARK_WORKER_MEMORY=2g
SPARK_WORKER_LIMITE=2816m
