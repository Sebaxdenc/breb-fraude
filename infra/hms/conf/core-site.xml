<?xml version="1.0"?>
<!-- Acceso del Hive Metastore a SeaweedFS. El metastore revisa y crea la carpeta de cada esquema y
     de cada tabla que se registra, así que necesita leer S3. Credenciales: AWS_ACCESS_KEY_ID y
     AWS_SECRET_ACCESS_KEY (credenciales/s3.env). La conexión a PostgreSQL no va aquí: la pasa
     iniciar_hms.sh. -->
<configuration>
  <property>
    <name>fs.s3a.endpoint</name>
    <value>http://seaweedfs:8333</value>
  </property>
  <property>
    <name>fs.s3a.endpoint.region</name>
    <value>us-east-1</value>
  </property>
  <property>
    <name>fs.s3a.path.style.access</name>
    <value>true</value>
  </property>
  <property>
    <name>fs.s3a.connection.ssl.enabled</name>
    <value>false</value>
  </property>
  <property>
    <name>fs.s3a.aws.credentials.provider</name>
    <value>software.amazon.awssdk.auth.credentials.EnvironmentVariableCredentialsProvider</value>
  </property>
  <!-- Trino puede entregar rutas s3:// en lugar de s3a://: las dos van a S3A. -->
  <property>
    <name>fs.s3.impl</name>
    <value>org.apache.hadoop.fs.s3a.S3AFileSystem</value>
  </property>
</configuration>
